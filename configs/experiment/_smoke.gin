# for unit-test smoke only; do not use for reporting
build_runspec.workdir = "runs/smoke"
build_runspec.seeds = [0]
build_runspec.num_clients = 2
build_runspec.dirichlet_alpha = 0.5
build_runspec.rounds = 2
build_runspec.local_epochs = 1
build_runspec.batch_size = 8
build_runspec.num_steps_per_epoch = 4
build_runspec.samples_per_site = 48
build_runspec.image_size = 32
build_runspec.patch_size = 16
build_runspec.vision_dim = 32
build_runspec.vision_depth = 2
build_runspec.vision_heads = 2
build_runspec.text_dim = 32
build_runspec.text_depth = 2
build_runspec.text_heads = 2
build_runspec.text_vocab = 256
build_runspec.max_text_len = 16
build_runspec.embed_dim = 32
build_runspec.num_groups = 6
build_runspec.temperature = 0.07
build_runspec.lambda_vl = 0.5
build_runspec.beta_freq = 0.3
build_runspec.tau_agg = 0.1
build_runspec.dro_step = 0.01
build_runspec.swad_period = 1
build_runspec.swad_warmup = 1
build_runspec.freq_ratio = 0.25
build_runspec.freq_mix = 0.5
build_runspec.drop_guard = 0.05
build_runspec.drop_boost = 2.0
build_runspec.eval_every = 1
build_runspec.device = "cpu"
build_runspec.use_real_backbones = False
build_runspec.datasets = ["ddi", "fitzpatrick17k"]
build_runspec.mechanisms = ["vla", "dg", "fairness"]
